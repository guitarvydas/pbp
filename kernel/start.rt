defvar load_errors ⇐ ⊥
defvar ticktime ⇐ 0

defn load_error (s) {
    global load_errors
    #print_stderr (s)
    #print_nl_stderr ()
    load_errors ⇐ ⊤
}

defn runtime_error (s) {
    #print_stderr (s)
    #print_nl_stderr ()
    #abort ()
}

⌈ diagnostics (dropped mevents, probes); redefine to redirect⌉
defn report (kind, s) {
    #live_update (kind, s)
}

defn initialize_palette (containers) {
    deftemp reg ⇐ make_component_registry ()
    for container in containers {
        register_component (reg, mkTemplate (container@“name”, container, ↪︎container_instantiator))
    }
    initialize_stock_components (reg)
    return reg
}

defn initialize_palette_from_files (diagram_source_files) {
    deftemp containers ⇐ []
    for diagram_source in diagram_source_files {
        all_containers_within_single_file ≡ lnet2internal_from_file (diagram_source)
        for container in all_containers_within_single_file {
            #append (containers, container)
        }
    }
    return initialize_palette (containers)
}

defn initialize_palette_from_string (lnet) {
    return initialize_palette (lnet2internal_from_string (lnet))
}

defn start (arg, part_name, palette) {
     part ≡ start_bare (part_name, palette)
     inject (part, “”, arg)
     finalize (part)
}

defn start_bare (part_name, palette) {
    ⌈ get entrypoint container⌉
    deftemp part ⇐ get_component_instance (palette, part_name, ϕ)
    if ϕ = part {
        load_error (#strcons (“Couldn't find container /”, #strcons (part_name, “/”)))
    }
    return part
}

⌈ Enqueue a mevent on the part, handle it, and keep ticking while the part is active.⌉
⌈ Used for testing a part, or to run a complete app from a kick-off mevent.⌉
defn inject (part, port, payload) {
    global load_errors
    if load_errors {
        #abort ()
    } else {
        enqueue (part, make_mevent (port, payload))
        handle (part)
        while part.state = “active” {
            tick (part)
        }
    }
}

defn finalize (part) {
    #queue_as_json_to_stdout (part.outq)
}
