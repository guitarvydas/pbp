⌈ Directions of wires. This section is the only place that knows how a direction is represented⌉
⌈ (here: strings). To use integers, change the four constants and direction_label; nothing else changes.⌉
defvar directionDown ⇐ “down”
defvar directionAcross ⇐ “across”
defvar directionUp ⇐ “up”
defvar directionThrough ⇐ “through”

⌈ d is the number used for a direction in the diagram JSON: 0 down, 1 across, 2 up, 3 through.⌉
⌈ Returns ϕ for any other number.⌉
defn direction_of_json (d) {
    global directionDown
    global directionAcross
    global directionUp
    global directionThrough
    if d = 0 {
        return directionDown
    } elif d = 1 {
        return directionAcross
    } elif d = 2 {
        return directionUp
    } elif d = 3 {
        return directionThrough
    } else {
        return ϕ
    }
}

⌈ direction   sender                   receiver⌉
⌈ down        the container            a child⌉
⌈ across      a child                  a child⌉
⌈ up          a child                  the container⌉
⌈ through     the container            the container⌉
defn sender_is_container (direction) {
    global directionDown
    global directionThrough
    return direction = directionDown or direction = directionThrough
}

defn receiver_is_container (direction) {
    global directionUp
    global directionThrough
    return direction = directionUp or direction = directionThrough
}

⌈ Routing connection (wire) for a container. The `direction` field has no effect⌉
⌈ on routing; it is there for debugging, or for reading by other tools.⌉
defobj Connector {
        • direction ⇐ ϕ ⌈ down, across, up, through⌉
        • sender ⇐ ϕ
        • receiver ⇐ ϕ
}

⌈ `Sender` is matched on the part (identity) and the port name.⌉
defobj Sender {
        • component ⇐ ϕ
        • port ⇐ ϕ
}

⌈ `Receiver` is the part and port that a mevent is delivered to.⌉
⌈ When the receiver is the container itself (up and through wires) the port is an output gate.⌉
defobj Receiver {
        • component ⇐ ϕ
        • port ⇐ ϕ
}

defn mkSender (component, port) {
    deftemp s ⇐ #fresh (Sender)
    s.component ⇐ component
    s.port ⇐ port
    return s
}

defn mkReceiver (component, port) {
    deftemp r ⇐ #fresh (Receiver)
    r.component ⇐ component
    r.port ⇐ port
    return r
}

defn mkConnector (direction, sender, receiver) {
    deftemp c ⇐ #fresh (Connector)
    c.direction ⇐ direction
    c.sender ⇐ sender
    c.receiver ⇐ receiver
    return c
}

⌈ JSON: {'dir': 0, 'source': {'name': '', 'id': 0}, 'source_port': '', 'target': {'name': 'Echo', 'id': 12}, 'target_port': ''},⌉
⌈ The sender port is proto_conn@"source_port" and the receiver port is proto_conn@"target_port".⌉
⌈ A child sender is proto_conn@"source", a child receiver is proto_conn@"target".⌉
⌈ Returns ϕ if the wire can not be made.⌉
defn create_connector (container, proto_conn, children_by_id) {
    direction ≡ direction_of_json (proto_conn@“dir”)
    if direction = ϕ {
        load_error (#strcons (“unknown wire direction ”, #asstr (proto_conn@“dir”)))
        return ϕ
    }
    deftemp sender_component ⇐ container
    if not (sender_is_container (direction)) {
        sid ≡ (proto_conn@“source”)@“id”
        sender_component ⇐ children_by_id@sid
    }
    deftemp receiver_component ⇐ container
    if not (receiver_is_container (direction)) {
        tid ≡ (proto_conn@“target”)@“id”
        receiver_component ⇐ children_by_id@tid
    }
    if sender_component = ϕ or receiver_component = ϕ {
        load_error (#strcons (#dirAsString (direction), “ wire: no such source or target”))
        return ϕ
    }
    return mkConnector (direction,
                        mkSender (sender_component, proto_conn@“source_port”),
                        mkReceiver (receiver_component, proto_conn@“target_port”))
}
