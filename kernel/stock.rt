⌈ Stock parts. All others are assumed to exist in supplementary palette libraries.⌉

defn trash_instantiate (reg, owner, name, template_data, arg) {
    return make_leaf (name, owner, ϕ, “”, ↪︎trash_handler, ϕ)
}

defn trash_handler (eh, mev) {
    pass
}

⌈ Stop: asks the parent to reset itself and all its children.⌉
defn stop_instantiate (reg, owner, name, template_data, arg) {
    return make_leaf (name, owner, ϕ, “”, ↪︎stop_handler, ϕ)
}

defn stop_handler (eh, mev) {
    request_reset (eh)
}

⌈ 1→2: waits for a mevent on port “1” and one on port “2”, in either order, then sends the payloads on “1” and “2”, in that order.⌉
defobj Pair {
        • first ⇐ ϕ
        • second ⇐ ϕ
}

defn deracer_reset_handler (eh) {
    eh.instance_data ⇐ #fresh (Pair)
}

defn deracer_instantiate (reg, owner, name, template_data, arg) {
    return make_leaf (name, owner, #fresh (Pair), “”, ↪︎deracer_handler, ↪︎deracer_reset_handler)
}

defn deracer_handler (eh, mev) {
    deftemp pair ⇐ eh.instance_data
    if “1” = mev.port and pair.first = ϕ {
        pair.first ⇐ mev
    } elif “2” = mev.port and pair.second = ϕ {
        pair.second ⇐ mev
    } else {
        runtime_error (#strcons (“1→2: unexpected mevent on port '”, #strcons (mev.port, “'”)))
    }
    if pair.first != ϕ and pair.second != ϕ {
        send (eh, “1”, pair.first.payload)
        send (eh, “2”, pair.second.payload)
        eh.instance_data ⇐ #fresh (Pair)
    }
}

⌈ Read Text File: the payload is a file name; sends the contents on “”, or an error message on “✗”.⌉
defn read_text_file_instantiate (reg, owner, name, template_data, arg) {
    return make_leaf (name, owner, ϕ, “”, ↪︎read_text_file_handler, ϕ)
}

defn read_text_file_handler (eh, mev) {
    fname ≡ mev.payload
    # low_level_read_text_file_handler (eh, mev, fname, “”, “✗”)
}

defn initialize_stock_components (reg) {
    register_component (reg, mkTemplate (“1then2”, ϕ, ↪︎deracer_instantiate))
    register_component (reg, mkTemplate (“1→2”, ϕ, ↪︎deracer_instantiate))
    register_component (reg, mkTemplate (“trash”, ϕ, ↪︎trash_instantiate))
    register_component (reg, mkTemplate (“🗑️”, ϕ, ↪︎trash_instantiate))
    register_component (reg, mkTemplate (“stop”, ϕ, ↪︎stop_instantiate))
    register_component (reg, mkTemplate (“🚫”, ϕ, ↪︎stop_instantiate))
    register_component (reg, mkTemplate (“Read Text File”, ϕ, ↪︎read_text_file_instantiate))
}
