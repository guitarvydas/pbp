        <UserObject label="xxx.drawio.json:&#xa;&#xa;&#xa;- JSON array of diagrams&#xa;&#xa;&#xa;    - a diagram is (a Container)&#xa;        - &quot;name&quot; : &quot;...&quot;,&#xa;        - &quot;children&quot; : [ child_id+ ]&#xa;        - &quot;connections&quot; : [ wire+ ]&#xa;        - &quot;file&quot; : &quot;xxx.drawio&quot;&#xa;&#xa;&#xa;&#xa;&#xa;        - child_id is&#xa;            { &#xa;                &quot;name&quot; : &quot;...&quot; &#xa;                &quot;id&quot; : int &#xa;            }&#xa;            &#xa;        - a wire is&#xa;            { &#xa;                &quot;dir&quot;: 0|1|2|3 &#xa;                &quot;source_port&quot;: &quot;...&quot; &#xa;                &quot;target_port&quot;: &quot;...&quot; &#xa;                &quot;source&quot; : child_id        &lt;-- missing if source = self (dir = 0)&#xa;                &quot;target&quot; : child_id        &lt;-- missing if target = self (dir = 2)&#xa;            }&#xa;            &#xa;                &#xa;                &#xa;&#xa;&#xa;interned strings:&#xa;&quot;name&quot;&#xa;&quot;children&quot;&#xa;&quot;connections&quot;&#xa;&quot;file&quot;&#xa;&quot;id&quot;&#xa;&quot;dir&quot;&#xa;&quot;source_port&quot;&#xa;&quot;target_port&quot;&#xa;&quot;source&quot;&#xa;&quot;target&quot;" link="xxx.drawio.json:&#xa;&#xa;&#xa;- JSON array of diagrams&#xa;&#xa;&#xa;    - a diagram is&#xa;        - &quot;name&quot; : &quot;...&quot;,&#xa;        - &quot;children&quot; : [ child_id+ ]&#xa;        - &quot;connections&quot; : [ wire+ ]&#xa;        - &quot;file&quot; : &quot;xxx.drawio&quot;&#xa;&#xa;&#xa;&#xa;&#xa;        - child_id is&#xa;            { &#xa;                &quot;name&quot; : &quot;...&quot; &#xa;                &quot;id&quot; : int &#xa;            }&#xa;            &#xa;        - a wire is&#xa;            { &#xa;                &quot;dir&quot;: 0|1|2|3 &#xa;                &quot;source_port&quot;: &quot;...&quot; &#xa;                &quot;target_port&quot;: &quot;...&qu