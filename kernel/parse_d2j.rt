buff contains the input source string
buffx is the index to the next uncomsumed character (if buffx > len(buff), no more chars)
put resulting object onto result_stack

parse { ... } otherwise { ... }

defparser parse_down_dir () {
  // on a successful parse, this leaves a down_wire object on the result_stack
  parse {
    "{" <dirDown | sourcePort | targetPort | target> "}"
    collapse 4 results into a down_dir object on the result stack
  }
}

defparser parse_across_dir () {
  // on a successful parse, this leaves an across_wire object on the result_stack
  parse {
    "{" <dirAcross | source | sourcePort | target | targetPort > "}"
    collapse 5 results into a across_dir object on the result stack
  }
}

defparser parse_up_dir () {
  // on a successful parse, this leaves an up_wire object on the result_stack
  parse {
    "{" <dirAcross | source | sourcePort | target | targetPort > "}"
    collapse 5 results into a up_dir object on the result stack
  }
}

defparser parse_through_dir () {
  // on a successful parse, this leaves an through_wire object on the result_stack
  parse {
    "{" <dirAcross | sourcePort | targetPort > "}"
    collapse 3 results into a through_dir object on the result stack
  }
}



//////////////
// kv means "key value"
//////////////

defparser dirDown >> kv(int) object {
  // on success, leaves 1 kv("dir",int(0)) object on result stack
  all of the following in order {
    parse keyword "dir"
    parse string ":"
    parse int 0
  } then {
    create dir down kv object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser source_port to kv object {
  // on success, leaves 1 kv("source_port",string) object on result stack 
  all of the following in order {
    parse keyword "source_port"
    parse string ":"
    parse string any
  } then {
    create source_port kv object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser target_port to kv object {
  // on success, leaves 1 kv("target_port", string) object on the result stack 
  all of the following in order {
    parse keyword "target_port"
    parse string ":"
    parse string any
  } then {
    create target_port kv object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser source to child_id object {
  // on success, leaves 1 kv("source", child_id) object on the result stack
  all of the following in order {
    parse keyword "source"
    parse string ":"
    parse child_id
  } then {
    create source child_id object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser target to child_id object {
  // on success, leaves 1 kv("target", child_id) object on the result stack
  all of the following in order {
    parse keyword "target"
    parse string ":"
    parse child_id
  } then {
    create target child_id object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser child_id {
  // on success, leaves 1 child_id object on the result stack
  parse {
    parse string "{"
    one of each of these in any order {
      | parse name to kv(string)
      | parse id to kv(int)
    }
    parse string "}"
    create child_id object on result stack
    return parse success
  } otherwise {
    return parse fail
  }
}

}

