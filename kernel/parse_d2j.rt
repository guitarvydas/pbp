//////////////
// kv means "key value"
//////////////

defparser parse_down {
  uparse {
    @kv_down
    @sourcePort
    @targetPort
    @target
  }
  pack-obj 4  
}

defparser parse_across {
  uparse {
    @kv_across
    @sourcePort
    @targetPort
    @target
    @source
  }
  pack-obj 5
}

defparser parse_up {
  uparse {
    @kv_up
    @targetPort
    @sourcePort
    @source
  }
  pack-obj 4
}

defparser parse_through {
  uparse {
    @kv_through
    @targetPort
    @sourcePort
  }
  pack-obj 3
}




defparser kv_down {
  parse {
    key "dir"
    int 0
  }
  pack-kv 2
}
defparser kv_across {
  parse {
    key "dir"
    int 1
  }
  pack-kv 2
}
defparser kv_up {
  parse {
    key "dir"
    int 2
  }
  pack-kv 2
}
defparser kv_through {
  parse {
    key "dir"
    int 3
  }
  pack-kv 2
}

defparser sourcePort {
  parse {
    key "source_port"
    string _
  }
  pack-kv 2
}

// key parse string and colon and leaves only key as an istr on the stack, string _ parses any dquoted string
// and leaves it as a str on the stack
// parse { ... } contains parsing actions, if parse is successful, then commands following { ... }
// are executed, else stack is returned to pre-parse state (i.e. partial parse items removed)
defparser targetPort {
  parse {
    key "target_port"
    string _
  }
  pack-kv 2
}

defparser target {
  parse {
    key "target"
    @child_id
  }
  pack-kv 2
}

defparser child_id {
  parse {
    @name
    @id
  }
  pack-obj 2
}

defparser name {
  parse {
    key "name"
    string _
  }
  pack-kv 2
}

defparser name {
  parse {
    key "id"
    int _
  }
  pack-kv 2
}

---

defparser dirDown >> kv(int) object {
  // on success, leaves 1 kv("dir",int(0)) object on result stack
  all of the following in order {
    parse keyword "dir"
    parse string ":"
    parse int 0
  } then {
    create dir down kv object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser source_port to kv object {
  // on success, leaves 1 kv("source_port",string) object on result stack 
  all of the following in order {
    parse keyword "source_port"
    parse string ":"
    parse string any
  } then {
    create source_port kv object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser target_port to kv object {
  // on success, leaves 1 kv("target_port", string) object on the result stack 
  all of the following in order {
    parse keyword "target_port"
    parse string ":"
    parse string any
  } then {
    create target_port kv object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser source to child_id object {
  // on success, leaves 1 kv("source", child_id) object on the result stack
  all of the following in order {
    parse keyword "source"
    parse string ":"
    parse child_id
  } then {
    create source child_id object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser target to child_id object {
  // on success, leaves 1 kv("target", child_id) object on the result stack
  all of the following in order {
    parse keyword "target"
    parse string ":"
    parse child_id
  } then {
    create target child_id object on result stack
    return parse success
  } otherwise {
    return parse fail
  }  
}

defparser child_id {
  // on success, leaves 1 child_id object on the result stack
  parse {
    parse string "{"
    one of each of these in any order {
      | parse name to kv(string)
      | parse id to kv(int)
    }
    parse string "}"
    create child_id object on result stack
    return parse success
  } otherwise {
    return parse fail
  }
}

}

