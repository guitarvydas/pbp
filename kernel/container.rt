defn make_container (name, owner) {
    deftemp eh ⇐ #fresh (Eh)
    eh.name ⇐ name
    eh.owner ⇐ owner
    eh.handler ⇐ ↪︎container_handler
    eh.reset_function ⇐ ↪︎container_reset
    return eh
}

defn container_instantiator (reg, owner, name, desc, arg) {
    container ≡ make_container (name, owner)
    children_by_id ≡ {}
    for child_desc in desc@“children” {
        child ≡ get_component_instance (reg, child_desc@“name”, container)
        #append (container.children, child)
        id ≡ child_desc@“id”
        children_by_id@id ⇐ child
    }
    for proto_conn in desc@“connections” {
        conn ≡ create_connector (container, proto_conn, children_by_id)
        if conn != ϕ {
            #append (container.connections, conn)
        }
    }
    return container
}

⌈ The handler of every container.⌉
⌈ A tick ticks the active children. Any other mevent is routed from the container itself (down and through wires).⌉
⌈ Then the container steps its children until it is no longer busy.⌉
defn container_handler (container, mev) {
    if is_tick (mev) {
        for child in container.children {
            if child.state = “active” {
                tick (child)
            }
        }
    } else {
        route (container, container, mev)
    }
    run (container)
}

defn run (container) {
    while busy (container) {
        if step_children (container) {
            return ϕ
        }
    }
}

⌈ A leaf is busy if its input queue is non-empty or it is active.⌉
⌈ A container is busy if its visit queue is non-empty or any child is busy.⌉
defn busy (part) {
    if 0 = #len (part.children) {
        return (not (#empty (part.inq))) or part.state = “active”
    }
    if not (#empty (part.visit_queue)) {
        return ⊤
    }
    for child in part.children {
        if busy (child) {
            return ⊤
        }
    }
    return ⊥
}

⌈ A VIP part goes to the head of the visit queue, any other part to the end.⌉
defn visit (container, part) {
    if part.vip {
        #prequeue (container.visit_queue, part)
    } else {
        #enqueue (container.visit_queue, part)
    }
}

⌈ One pass over the children. Returns ⊤ if a reset was carried out.⌉
defn step_children (container) {
    todo ≡ #queue2list (container.visit_queue)
    #resetQueue (container.visit_queue)
    handled ≡ []
    ⌈ phase 1 - each visited part handles one mevent⌉
    for child in todo {
        if not (#empty (child.inq)) {
            handle (child)
            #append (handled, child)
            if container.reset_requested {
                container.reset_requested ⇐ ⊥
                container_reset (container)
                return ⊤
            }
        }
    }
    ⌈ active parts that were not given a mevent are ticked⌉
    for child in container.children {
        if child.state = “active” and not (child in handled) {
            tick (child)
        }
    }
    ⌈ phase 2 - route the outputs of the children⌉
    container.state ⇐ “idle”
    for child in container.children {
        if child.state = “active” {
            container.state ⇐ “active”
        }
        for mev in fetch_output_queue (child) {
            route (container, child, mev)
        }
    }
    return ⊥
}

⌈ Routes a single mevent to all matching wires of the container.⌉
defn route (container, from_part, mev) {
    deftemp was_sent ⇐ ⊥
    for conn in container.connections {
        if conn.sender.component = from_part and conn.sender.port = mev.port {
            deposit (container, conn, mev)
            was_sent ⇐ ⊤
        }
    }
    if not was_sent {
        report (“dropped”, #strcons (container.name, #strcons (“: mevent on port '”, #strcons (mev.port, #strcons (“' from ”, #strcons (from_part.name, “ has no wire”))))))
    }
}

⌈ Delivers a copy of the mevent, with the port of the receiver, to the receiver of the wire.⌉
defn deposit (container, conn, mev) {
    new_mev ≡ make_mevent (conn.receiver.port, mev.payload)
    if conn.receiver.to_output {
        #enqueue (conn.receiver.component.outq, new_mev)
    } else {
        enqueue (conn.receiver.component, new_mev)
        visit (container, conn.receiver.component)
    }
}

⌈ Reset all children and the container itself to a known state.⌉
defn container_reset (container) {
    for child in container.children {
        reset (child)
    }
    #resetQueue (container.visit_queue)
    #resetQueue (container.inq)
    #resetQueue (container.outq)
    container.reset_requested ⇐ ⊥
    container.state ⇐ “idle”
}
