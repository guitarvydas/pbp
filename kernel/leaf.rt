⌈ Creates a new leaf out of a handler function, and a data parameter⌉
⌈ that will be handed back to your handler when called.⌉
⌈ `name` is the full instance name made by get_component_instance.⌉

defn make_leaf (name, owner, instance_data, arg, handler, reset_handler) {
    deftemp eh ⇐ #fresh (Eh)
    eh.name ⇐ name
    eh.owner ⇐ owner
    eh.handler ⇐ handler
    eh.reset_handler ⇐ reset_handler
    eh.reset_function ⇐ ↪︎leaf_reset
    eh.instance_data ⇐ instance_data
    eh.arg ⇐ arg
    return eh
}

⌈ Reset a leaf to a known, idle state.⌉
defn leaf_reset (part) {
    #resetQueue (part.inq)
    #resetQueue (part.outq)
    if (part.reset_handler != ϕ) {
        part.reset_handler (part)
    }
    part.state ⇐ “idle”
}
