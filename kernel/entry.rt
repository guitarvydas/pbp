⌈ Entry points. Invoked by the parent container.⌉

defn enqueue (eh, mev) {
    #enqueue (eh.inq, mev)
}

⌈ The part pops the first mevent of its own input queue and handles it.⌉
defn handle (eh) {
    mev ≡ #dequeue (eh.inq)
    eh.handler (eh, mev)
}

⌈ The part continues processing; no mevent is popped.⌉
defn tick (eh) {
    eh.tick (eh)
}

defn reset (eh) {
    eh.reset (eh)
}

⌈ Returns the output queue of the part, in order, and clears it.⌉
defn fetch_output_queue (eh) {
    out ≡ #queue2list (eh.outq)
    #resetQueue (eh.outq)
    return out
}

⌈ Calls available inside a part.⌉

defn send (eh, port, payload) {
    #enqueue (eh.outq, make_mevent (port, payload))
}

⌈ Calls reset on the parent container at once. This resets the calling part too, so request_reset⌉
⌈ should be the last thing a part does (it may still send afterwards).⌉
defn request_reset (eh) {
    if ϕ = eh.owner {
        runtime_error (#strcons (“request_reset: ”, #strcons (eh.name, “ has no parent”)))
    } else {
        reset (eh.owner)
    }
}

defn remain_active (eh, flag) {
    if flag {
        eh.state ⇐ “active”
    } else {
        eh.state ⇐ “idle”
    }
}

defn enable_vip (eh, flag) {
    eh.vip ⇐ flag
}
