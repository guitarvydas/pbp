defproc readContainerTemplate (filename) {
  withTempString fstr = #readTextFileIntoString (filename) {
    parse {
      @diagramArray
    }
  }
}

defparser diagramArray {
  parse {
    "["
      {
        @diagram
      }
    "]"
  }
  pack-array-obj
}

defparser diagram {
  parse {
    @name
    @children
    @connections
    @file
  }
  pack-obj 4
}

defparser name {
  parse {
    key "name"
    string _
  }
  pack-kv 2
}

defparser children {
  parse {
    "["
      {
        @child
      }
    "]"
  }
  pack-array-obj
}

defparser connections {
  parse {
    "["
      {
        @connection
      }
    "]"
  }
  pack-array-obj
}

defparser file {
  parse {
    key "file"
    string _
  }
  pack-kv 2
}

defparser child {
  parse {
    "{"
    @name
    @id
    "}"
  }
  pack-obj 4
}

defparser id {
  parse {
    key "id"
    int _
  }
  pack-kv 2
}

defparser connection {
  parse one of {
    @acrossConnection
    @downConnection
    @upConnection
    @throughConnection
  }
}

defparser acrossConnection {
  parse in any order {
    @directionAcross
    @source
    @sourcePort
    @target
    @targetPort
  }
  pack-kv 5
}

defparser downConnection {
  parse in any order {
    @directionDown
    @sourcePort
    @target
    @targetPort
  }
  pack-kv 4
}

defparser upConnection {
  parse in any order {
    @directionUp
    @source
    @sourcePort
    @targetPort
  }
  pack-kv 4
}

defparser throughConnection {
  parse in any order {
    @directionThrough
    @sourcePort
    @targetPort
  }
  pack-kv 3
}

defparser acrossDirection {
  parse {
    key "dir"
    int 1
  }
  pack-kv 2
}

defparser downDirection {
  parse {
    key "dir"
    int 0
  }
  pack-kv 2
}

defparser upDirection {
  parse {
    key "dir"
    int 2
  }
  pack-kv 2
}

defparser throughDirection {
  parse {
    key "dir"
    int 3
  }
  pack-kv 2
}




defvar registry ⇐ #fresh_kvdict (Template)


defkvobj LeafTemplate {
  • name
  • instantiator
}

defkvobj ChildTemplate {
  • name
  • id
}

defkvobj ContainerTemplate {
  • name
  • instantiator
  • children
  • wires
}

defkvobj WireTemplate {
  • direction
  • sender
  • receiver
}

----------------------------

defobj Template {
        • template_data ⇐ ϕ
}

defn mkTemplate (name, template_data, instantiator) {
     deftemp templ ⇐ #fresh (Template)
     templ.name ⇐ name
     templ.template_data ⇐ template_data
     templ.instantiator ⇐ instantiator
     return templ
}

⌈ convert a little-network to internal form (an object data structure created by json parser) ... ⌉
⌈ the actual data structure depends on the json parser library used by the target language ⌉
⌈ the form of the data structure doesn't matter here, as long as we use lookup operators "@" in this .rt code ⌉

⌈ ... by reading the little-net from an external file ⌉
defn lnet2internal_from_file (container_xml) {
    pathname ≡ #get_wd ()
    filename ≡ #basename (container_xml)
    #read_and_convert_lnet_file (pathname, filename)
}

⌈ ... by reading the little-net from an embedded string (an aspect of creating t2t tool code) ⌉
defn lnet2internal_from_string (lnet) {
    #internalize_lnet_from_string ()
}

defn make_component_registry () {
    return #fresh (Component_Registry)
}

defn register_component (reg, template) { return abstracted_register_component (reg, template,  ⊥) }
defn register_component_allow_overwriting (reg, template) { return abstracted_register_component (reg, template,  ⊤) }

defn abstracted_register_component (reg, template, ok_to_overwrite) {
    name ≡ template.name
    if reg != ϕ and name in reg.templates and not ok_to_overwrite {
        load_error (#strcons (“Component /”, #strcons (template.name, “/ already declared”)))
        return reg
    } else {
        reg.templates@name ⇐ template
        return reg
    }
}

⌈ Every instance gets a unique full name: the name of the owner, “▹”, the template name and a subscripted counter.⌉
defn generate_instance_name (owner, template_name) {
    if ϕ = owner {
        return gensymbol (template_name)
    } else {
        return #strcons (owner.name, #strcons (“▹”, gensymbol (template_name)))
    }
}

defn get_component_instance (reg, template_name, owner) {
    ⌈ A name that begins with ":" is a JIT part (see jit.rt)⌉
    if “:” = #stringcar (template_name) {
        return jit_instantiate (reg, owner, generate_instance_name (owner, template_name), template_name)
    } elif template_name in reg.templates {
        template ≡ reg.templates@template_name
        instance_name ≡ generate_instance_name (owner, template_name)
        return template.instantiator (reg, owner, instance_name, template.template_data, “”)
    } else {
        load_error (#strcons (“Can't find component /”, #strcons (template_name, “/”)))
        return ϕ
    }
}
